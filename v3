-- TOGGLE FUNCTIONS
--==================================================

local function updateStatus()
	aimToggle.Text = aimEnabled and "ON" or "OFF"
	wallToggle.Text = wallVisionEnabled and "ON" or "OFF"

	aimToggle.BackgroundColor3 =
		aimEnabled
		and Color3.fromRGB(45,130,70)
		or Color3.fromRGB(90,45,45)

	wallToggle.BackgroundColor3 =
		wallVisionEnabled
		and Color3.fromRGB(45,130,70)
		or Color3.fromRGB(90,45,45)

	status.Text =
		"Aim Assist: " .. (aimEnabled and "ON" or "OFF")
		.. "\nWall Vision: " .. (wallVisionEnabled and "ON" or "OFF")
end

aimToggle.Activated:Connect(function()
	aimEnabled = not aimEnabled
	updateStatus()
end)

wallToggle.Activated:Connect(function()
	wallVisionEnabled = not wallVisionEnabled
	updateStatus()
end)

--==================================================
-- MOBILE/PC SLIDER
--==================================================

local draggingSlider = false

local function setSliderFromX(x)
	local left = sliderBack.AbsolutePosition.X
	local width = sliderBack.AbsoluteSize.X

	local percent = math.clamp((x - left) / width, 0, 1)

	aimStrength = math.floor(percent * 100)

	sliderFill.Size = UDim2.new(percent,0,1,0)
	sliderButton.Position =
		UDim2.new(percent,-12,0.5,-12)

	strengthLabel.Text =
		"Aim Strength: " .. aimStrength .. "%"
end

sliderButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		draggingSlider = true
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if draggingSlider then
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			setSliderFromX(input.Position.X)
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		draggingSlider = false
	end
end)

sliderBack.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		setSliderFromX(input.Position.X)
	end
end)

